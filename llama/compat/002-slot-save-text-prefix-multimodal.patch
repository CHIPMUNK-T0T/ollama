+    // Like check_no_mtmd, but multimodal-aware: a multimodal model can still
+    // save/restore the KV of a PURE-TEXT prefix. Media (image/audio) chunks
+    // occupy positions stored as LLAMA_TOKEN_NULL placeholders, which the
+    // flat-token slot save format cannot represent. get_text_tokens() drops
+    // those placeholders, so a size mismatch means the slot holds media.
+    // (get_tokens() cannot be used here: it asserts !has_mtmd.)
+    bool check_slot_text_only(const server_slot * slot, const int id_task) {
+        if (mctx && slot != nullptr &&
+                slot->prompt.tokens.get_text_tokens().size() != slot->prompt.tokens.size()) {
+            send_error(id_task,
+                "Slot KV save/restore is not supported while the slot holds image/audio tokens (a pure-text prefix is supported)",
+                ERROR_TYPE_NOT_SUPPORTED);
+            return false;
+        }
+        return true;
+    }
